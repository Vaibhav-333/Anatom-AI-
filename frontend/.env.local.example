# ─── Anatom AI — Frontend Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is already in .gitignore.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development  → leave as http://localhost:8000
# Production   → set to your Railway backend URL, e.g.:
#                https://anatom-ai-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App metadata (optional overrides) ────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Anatom AI
NEXT_PUBLIC_APP_VERSION=1.0.0
