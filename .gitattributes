# ─── Git LFS — large binary assets ──────────────────────────────────────────
# Only myology.glb stays in LFS — it is 153 MB and exceeds both GitHub's
# 100 MB hard push limit and Vercel's 100 MB static-file size limit.
# All other GLBs (≤ 83 MB) are committed as regular files so Vercel can
# serve them directly without any LFS configuration.
frontend/public/assets/anatomy/myology.glb filter=lfs diff=lfs merge=lfs -text

# Compressed model variants
*.draco filter=lfs diff=lfs merge=lfs -text

# Texture / image assets that can be large
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Trained model weights
*.pt   filter=lfs diff=lfs merge=lfs -text
*.pth  filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.h5   filter=lfs diff=lfs merge=lfs -text

# Ensure consistent line endings for text files
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.env* text eol=lf
