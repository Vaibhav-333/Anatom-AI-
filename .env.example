# ─── Anatom AI — Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS — Allowed origins (comma-separated) ──────────────────────────────────
# Add your Vercel production URL here after deploying the frontend.
# Example: https://anatom-ai.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path (relative to project root) — used by default.
DATABASE_PATH=data/anatom_ai.db

# ── Embeddings / FAISS ────────────────────────────────────────────────────────
EMBED_DIR=data/embeddings

# ── OTP / Email (optional — leave blank to disable email OTPs) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=noreply@anatomai.app

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
